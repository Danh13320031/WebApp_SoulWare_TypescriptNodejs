<div
  role="alert"
  class="alert alert-dismissible p-2 d-flex justify-content-between align-items-center global-alert"
  id="global-alert"
>
  <span
    class="global-alert-message"
    id="global-alert-message"
    style="
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-semibold);
    "
  ></span>
  <button
    type="button"
    class="button-icon-danger global-alert-close"
    id="global-alert-close"
  >
    <i class="fa-solid fa-xmark"></i>
  </button>
</div>
