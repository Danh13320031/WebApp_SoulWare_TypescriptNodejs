<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
    />

    <link rel="stylesheet" href="/client/styles/setup.css" />
    <link rel="stylesheet" href="/client/styles/lib/bootstrap.css" />
    <link rel="stylesheet" href="/client/styles/partials/header.css" />
    <link rel="stylesheet" href="/client/styles/pages/song/song.css" />
    <link rel="stylesheet" href="/client/styles/partials/footer.css" />
  </head>
  <body>
    <%-include('../../partials/header.view.ejs', { keyword: keyword }) %>

    <main class="main py-5" id="song-main">
      <section class="song-title">
        <div class="container my-3">
          <div class="row">
            <div class="col-12">
              <h1
                class="d-flex align-items-center song-title-text"
                style="
                  color: var(--primary-color);
                  font-size: var(--font-size-xl);
                  font-weight: var(--font-weight-semibold);
                "
              >
                <i
                  class="fa-solid fa-music me-2"
                  style="font-size: var(--font-size-md)"
                ></i>
                <%= pageTitle %>
              </h1>
            </div>
          </div>
        </div>
      </section>

      <section class="song-list">
        <div class="container">
          <div class="row g-2">
            <% if(songList.length > 0) { %>
              <% songList.forEach((song) => { %>
                <div class="col-lg-6 col-12">
                  <div class="song-item">
                    <div class="song-thumb">
                      <img
                        src="<%= song.avatar %>"
                        alt="<%= song.title %>"
                      />

                      <button class="play-btn" title="Phát nhạc">
                        <i class="fa-solid fa-play"></i>
                      </button>
                    </div>

                    <div class="song-info">
                      <h4 class="song-title"><%= song.title %></h4>

                      <div class="song-meta">
                        <span class="song-singer song-group">
                          <i class="fa-solid fa-microphone-lines"></i>
                          <% if (song.singers.length > 0 && song.singerGroups.length > 0) { %>
                            <% song.singers.forEach((singer, index) => { %>
                              <a
                                href="/singers/detail/<%= singer.slug %>"
                                class="text-decoration-none singer-name"
                                > <%= singer.stageName %> </a
                              ><%= index < song.singers.length - 1 ? "," : "" %>
                            <% }) %>
                            và
                            <% song.singerGroups.forEach((group, index) => { %>
                              <a
                                href="/singer-groups/detail/<%= group.slug %>"
                                class="text-decoration-none group-name"
                                > <%= group.name %> </a
                              ><%= index < song.singerGroups.length - 1 ? "," : "" %>
                            <% }) %>
                          <% } else { %>
                            <% if (song.singers.length > 0) { %>
                              <% song.singers.forEach((singer, index) => { %>
                                <a
                                  href="/singers/detail/<%= singer.slug %>"
                                  class="text-decoration-none singer-name"
                                  > <%= singer.stageName %> </a
                                ><%= index < song.singers.length - 1 ? "," : "" %>
                              <% }) %>
                            <% } else { %>
                              <% song.singerGroups.forEach((group, index) => { %>
                                <a
                                  href="/singer-groups/detail/<%= group.slug %>"
                                  class="text-decoration-none group-name"
                                  > <%= group.name %> </a
                                ><%= index < song.singerGroups.length - 1 ? "," : "" %>
                              <% }) %>
                            <% } %>
                          <% } %>
                        </span>

                        <span class="song-like">
                          <i class="fa-solid fa-thumbs-up"></i>
                          <%= song.like %>
                        </span>

                        <span class="song-time">
                          <i class="fa-regular fa-clock"></i>
                          Hôm qua
                        </span>
                      </div>
                    </div>

                    <div class="song-actions">
                      <a
                        href="/songs/detail/<%= song.slug %>"
                        class="button-main text-decoration-none detail-btn"
                      >
                        Chi tiết
                        <i class="fa-solid fa-angle-right"></i>
                      </a>
                    </div>
                  </div>
                </div>
              <% }) %>
            <% } %>
          </div>
        </div>
      </section>
    </main>

    <%-include('../../partials/footer.view.ejs') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script
      src="https://kit.fontawesome.com/aaf479b433.js"
      crossorigin="anonymous"
    ></script>

    <script src="/client/scripts/search/searchSuggest.js"></script>
    <script src="/client/scripts/index.js"></script>
  </body>
</html>
