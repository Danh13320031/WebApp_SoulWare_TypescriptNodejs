<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
    />

    <link rel="stylesheet" href="/client/styles/setup.css" />
    <link rel="stylesheet" href="/client/styles/lib/bootstrap.css" />
    <link rel="stylesheet" href="/client/styles/partials/alert.css">
    <link rel="stylesheet" href="/client/styles/partials/header.css" />
    <link rel="stylesheet" href="/client/styles/partials/footer.css" />
  </head>
  <body>
    <%-include('../../partials/header.view.ejs', { keyword: keyword }) %>
    <%-include('../../partials/alert.view.ejs') %>

    <main class="main py-5" id="profile-main">
      <section class="profile-title">
        <div class="container my-3">
          <div class="row">
            <div class="col-12">
              <h1
                class="d-flex align-items-center profile-title-text"
                style="
                  color: var(--primary-color);
                  font-size: var(--font-size-xl);
                  font-weight: var(--font-weight-semibold);
                "
              >
                <i
                  class="fa-solid fa-user me-2"
                  style="font-size: var(--font-size-md)"
                ></i>
                <%= pageTitle %>
              </h1>
            </div>
          </div>
        </div>
      </section>

      <section class="profile-content">
        <div class="container">
          <form action="" enctype="multipart/form-data" class="row row-gap-3 profile-form">
            <div class="col-lg-3 col-md-4 col-12">
              <div class="d-flex flex-column align-items-center gap-2 profile-avatar-box">
                <div class="p-2 rounded-circle border border-3" style="border-color: var(--primary-color) !important; box-shadow: 0px 0px 10px var(--primary-color);">
                  <div class="overflow-hidden rounded-circle profile-avatar">
                    <img
                      src="<%= user.avatar %>"
                      alt="<%= user.fullName %>"
                      width="100%"
                      class="profile-avatar-img"
                      profile-avatar-img
                    />
                  </div>
                </div>
                <span class="form-error profile-avatar-error" style="
                  color: var(--error-color);
                  font-size: var(--font-size-sm);
                  font-weight: var(--font-weight-light);
                "></span>
                <div class="h-100 profile-avatar-button">
                  <button type="button" class="button-main profile-avatar-change" profile-avatar-change><i class="fa-regular fa-image me-2"></i>Thay đổi ảnh đại diện</button>
                  <button type="button" class="button-danger profile-avatar-remove" profile-avatar-remove>x</button>
                  <input type="file" name="avatar" accept="image/*" value="<%= user.avatar %>" class="d-none" profile-current-avatar-input />
                  <input type="hidden" name="oldAvatar" value="<%= user.avatar %>" class="d-none" profile-old-avatar-input />
                </div>
                <div 
                  class="text-center profile-avatar-fullName" 
                  style="
                    font-size: var(--font-size-lg); 
                    font-weight: var(--font-weight-semibold); 
                    color: var(--secondary-color);"
                >
                  <%= user.fullName %>
                </div>
                <div class="w-100 profile-avatar-description">
                  <textarea
                    name="description"
                    id="description"
                    class="form-control w-100 input-type-02"
                    placeholder="Nhập mô tả..."
                  ><%= user.description %></textarea>
                </div>
              </div>
            </div>
            <div class="col-lg-9 col-md-8 col-12">
              <div class="row row-gap-3">
                <div class="col-12">
                  <div class="profile-title-box" style="font-size: var(--font-size-lg); font-weight: var(--font-weight-semibold); color: var(--secondary-color);">
                    <span>Thông tin tài khoản</span>
                  </div>
                  <hr class="w-100 mb-0" style="border-color: var(--secondary-color)">
                </div>
                <div class="col-12">
                  <div class="d-flex flex-column gap-2 profile-info-box">
                      <div class="row form-group-email form-group-fullName">
                        <div class="col-6 form-group">
                          <label
                            for="email"
                            class="form-label label-type-01"
                            style="font-size: var(--font-size-md); color: var(--secondary-color);"
                          >
                            Địa chi email
                          </label>
                          <input
                            type="text"
                            placeholder="Nhập địa chi email..."
                            class="form-control input-type-02 profile-email-input"
                            id="email"
                            name="email"
                            value="<%= user.email %>"
                          />
                          <span class="form-error profile-email-error" style="
                            color: var(--error-color);
                            font-size: var(--font-size-sm);
                            font-weight: var(--font-weight-light);
                          "></span>
                        </div>
                        <div class="col-6 form-group">
                          <label
                            for="fullName"
                            class="form-label label-type-01"
                            style="font-size: var(--font-size-md); color: var(--secondary-color);"
                          >
                            Họ & Tên
                          </label>
                          <input
                            name="fullName"
                            type="text"
                            value="<%= user.fullName %>"
                            placeholder="Nhập họ & tên..."
                            class="form-control input-type-02 profile-fullName-input"
                            id="fullName"
                          />
                          <span class="form-error profile-fullName-error" style="
                            color: var(--error-color);
                            font-size: var(--font-size-sm);
                            font-weight: var(--font-weight-light);
                          "></span>
                        </div>
                      </div>
                      <div class="row form-group-phone form-group-birthday">
                        <div class="col-6 form-group">
                          <label
                            for="phone"
                            class="form-label label-type-01"
                            style="font-size: var(--font-size-md); color: var(--secondary-color);"
                          >
                            Số điện thoại
                          </label>
                          <input
                            type="text"
                            placeholder="Nhập số điện thoại..."
                            class="form-control input-type-02 profile-phone-input"
                            id="phone"
                            name="phone"
                            value="<%= user.phone %>"
                          />
                          <span class="form-error profile-phone-error" style="
                            color: var(--error-color);
                            font-size: var(--font-size-sm);
                            font-weight: var(--font-weight-light);
                          "></span>
                        </div>
                        <div class="col-6 form-group">
                          <label
                            for="birthday"
                            class="form-label label-type-01"
                            style="font-size: var(--font-size-md); color: var(--secondary-color);"
                          >
                            Ngày sinh
                          </label>
                          <input
                            name="birthday"
                            type="date"
                            value="<%= dayjs(user.birthday).format('YYYY-MM-DD') %>"
                            class="form-control input-type-02 profile-birthday-input"
                            id="birthday"
                          />
                          <span class="form-error profile-birthday-error" style="
                            color: var(--error-color);
                            font-size: var(--font-size-sm);
                            font-weight: var(--font-weight-light);
                          "></span>
                        </div>
                      </div>
                      <div class="row form-group-address">
                        <div class="col-12 form-group">
                          <label
                            for="address"
                            class="form-label label-type-01"
                            style="font-size: var(--font-size-md); color: var(--secondary-color);"
                          >
                            Địa chi
                          </label>
                          <input
                            type="text"
                            placeholder="Nhập địa chi..."
                            class="form-control input-type-02 profile-address-input"
                            id="address"
                            name="address"
                            value="<%= user.address %>"
                          />
                          <span class="form-error profile-address-error" style="
                            color: var(--error-color);
                            font-size: var(--font-size-sm);
                            font-weight: var(--font-weight-light);
                          "></span>
                        </div>
                      </div>
                      <div class="row form-group-password form-group-confirmPassword">
                        <div class="col-6 form-group">
                          <label
                            for="password"
                            class="form-label label-type-01"
                            style="font-size: var(--font-size-md); color: var(--secondary-color);"
                          >
                            Mật khẩu
                          </label>
                          <input
                            type="password"
                            placeholder="Nhập mật khẩu..."
                            class="form-control input-type-02 profile-password-input"
                            id="password"
                            name="password"
                          />
                          <span class="form-error profile-password-error" style="
                            color: var(--error-color);
                            font-size: var(--font-size-sm);
                            font-weight: var(--font-weight-light);
                          "></span>
                        </div>
                        <div class="col-6 form-group">
                          <label
                            for="confirmPassword"
                            class="form-label label-type-01"
                            style="font-size: var(--font-size-md); color: var(--secondary-color);"
                          >
                            Xác nhận mật khẩu
                          </label>
                          <input
                            type="password"
                            placeholder="Xác nhận mật khẩu..."
                            class="form-control input-type-02 profile-confirmPassword-input"
                            id="confirmPassword"
                            name="confirmPassword"
                          />
                          <span class="form-error profile-confirmPassword-error" style="
                            color: var(--error-color);
                            font-size: var(--font-size-sm);
                            font-weight: var(--font-weight-light);
                          "></span>
                        </div>
                      </div>
                  </div>
                </div>
                <div class="col-12">
                  <div class="profile-subscriptionPlan-title" style="font-size: var(--font-size-md); color: var(--secondary-color); font-weight: var(--font-weight-semibold);">Gói đang đăng ký: 
                    <% if (user.subscriptionPlanId.code === 'FREE') { %>
                    <span class="profile-subscriptionPlan-text">Bạn chưa đăng ký gói. <a href="/subscriptions" style="color: var(--primary-color);">Đăng ký ngay</a></span>
                    <% } else { %>
                    <a href="/subscriptions/<%= user.subscriptionPlanId.code %>" class="text-uppercase profile-subscriptionPlan-text" style="color: var(--primary-color);"><%= user.subscriptionPlanId.name %> (<%= user.subscriptionPlanId.code %>).</a>
                    <% } %>
                  </div>
                </div>
                <div class="col-12">
                  <div class="d-flex justify-content-end profile-button-box">
                    <button type="submit" class="text-center button-secondary"><i class="fa-regular fa-floppy-disk me-2"></i>Lưu thông tin</button>
                  </div>
                </div>
              </div>
            </div>
          </form>
        </div>
      </section>
    </main>

    <%-include('../../partials/footer.view.ejs') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script
      src="https://kit.fontawesome.com/aaf479b433.js"
      crossorigin="anonymous"
    ></script>

    <script src="/client/scripts/search/searchSuggest.js"></script>
    <script src="/client/scripts/index.js"></script>
    <script src="/client/scripts/user/changeAvatarImage.js"></script>
    <script src="/client/scripts/user/validateProfileForm.js"></script>
    <script src="/client/scripts/user/handleSubmitProfileForm.js"></script>
  </body>
</html>
