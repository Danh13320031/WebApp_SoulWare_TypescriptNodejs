<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/aplayer@1.10.1/dist/APlayer.min.css"
    />
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.5.2/dist/css/tom-select.css" rel="stylesheet">

    <link rel="stylesheet" href="/admin/styles/setup.css" />
    <link rel="stylesheet" href="/admin/styles/lib/bootstrap.css" />
    <link rel="stylesheet" href="/admin/styles/lib/tinyMCE.css" />
    <link rel="stylesheet" href="/admin/styles/lib/tomselect.css" />
    <link rel="stylesheet" href="/admin/styles/partials/sider.css" />
    <link rel="stylesheet" href="/admin/styles/partials/alert.css" />
    <link rel="stylesheet" href="/admin/styles/partials/modal.css" />
    <link rel="stylesheet" href="/admin/styles/partials/header.css" />
    <link rel="stylesheet" href="/admin/styles/partials/footer.css" />
    <link rel="stylesheet" href="/admin/styles/partials/imagePreview.css" />
  </head>
  <body>
    <%-include('../../partials/sider.view.ejs', { pathname: pathname }) %>
    <%-include('../../partials/alert.view.ejs') %>
    <%-include('../../partials/modal.view.ejs') %>
    <%-include('../../partials/header.view.ejs') %>

    <main class="main" id="main">
      <section
        class="singer-group-header main-header d-flex align-items-center justify-content-between flex-wrap gap-3"
      >
        <h1
          class="singer-group-title main-title"
          style="
            font-size: var(--font-size-xxl);
            font-weight: var(--font-weight-bold);
            color: var(--primary-color);
          "
        >
          <%= pageTitle %>
        </h1>
      </section>

      <section class="mb-5 singer-group-content main-content">
        <div class="card">
          <div class="card-header bg-white"></div>
          <div class="card-body">
            <form
              action="<%= prefixAdminPath %>/singer-groups/update/<%= singerGroup._id %>"
              method="POST"
              enctype="multipart/form-data"
              class="singer-group-update-form"
              id="singer-group-form"
              singer-group-update-form
            >
              <div class="container-fluid">
                <div class="row g-3">
                  <div class="col-12 mb-3">
                    <div
                      class="d-flex flex-column gap-3 form-group update-image-group"
                    >
                      <div
                        class="w-100 d-flex flex-column justify-content-center align-items-center gap-3 form-image-preview"
                        form-image-preview
                      >
                        <div
                          class="p-3 d-flex flex-column justify-content-center align-items-center position-relative gap-3 form-image-container"
                        >
                          <button
                            type="button"
                            class="position-absolute top-0 end-0 m-2 button-icon-danger form-image-remove"
                            form-image-remove
                          >
                            <i class="fa-solid fa-xmark"></i>
                          </button>
                          <img
                            src="<%= singerGroup.avatar %>"
                            alt="<%= singerGroup.name %>"
                            class="form-image-view"
                            form-image-view
                          />
                          <label
                            for="form-image-input"
                            class="button-primary text-decoration-none mb-0"
                            >Tải ảnh lên <i class="fa-solid fa-upload"></i>
                            <input type="hidden" name="oldAvatar" value="<%= singerGroup.avatar %>" class="form-avatar-view" form-avatar-view />
                            <input
                              type="file"
                              name="avatar"
                              accept="image/*"
                              class="form-control d-none form-image-input"
                              id="form-image-input"
                              form-image-input
                          /></label>
                        </div>
                        <span class="form-error form-image-error"></span>
                      </div>
                    </div>
                  </div>
                  <div class="col-lg-3 col-md-6 mb-3">
                    <div class="form-group update-name-group">
                      <label
                        for="singer-group-name"
                        class="form-label update-name-label"
                        >Tên nhóm</label
                      >
                      <input
                        type="text"
                        name="name"
                        value="<%= singerGroup.name %>"
                        placeholder="Nhập họ & tên..."
                        class="form-control update-name-input"
                        id="singer-group-name"
                      />
                      <span class="form-error form-name-error"></span>
                    </div>
                  </div>
                  <div class="col-lg-3 col-md-6 mb-3">
                    <% if(newSingerList && newSingerList.length > 0) { %>
                    <div class="form-group update-member-group">
                      <label
                        for="singer-group-member"
                        class="form-label update-member-label"
                        >Thành viên</label
                      >
                      <select name="singers[]" multiple placeholder="Chọn các thành viên..." autocomplete="off" class="form-control update-member-input" id="singer-group-member">
                        <% newSingerList.forEach((singer) => { %>
                        <option value="<%= singer._doc._id %>" <% if(singer.checked == true) { %>selected<% } %>><%= singer._doc.stageName %></option>
                        <% }) %>
                      </select>
                      <span class="form-error form-member-error"></span>
                    </div>
                    <% } %>
                  </div>
                  <div class="col-lg-3 col-md-6 mb-3">
                    <div class="form-group update-position-group">
                      <label
                        for="singer-group-position"
                        class="form-label update-position-label"
                        >Vị trí</label
                      >
                      <input
                        type="number"
                        name="position"
                        value="<%= singerGroup.position %>"
                        min="1"
                        placeholder="Nhập vị trí hoặc tự động tăng nếu để trống"
                        class="form-control update-position-input"
                        id="singer-group-position"
                      />
                      <span class="form-error form-position-error"></span>
                    </div>
                  </div>
                  <div class="col-lg-3 col-md-6 mb-3">
                    <div class="form-group update-status-group">
                      <label
                        for="singer-group-status"
                        class="form-label update-status-label"
                        >Trạng thái</label
                      >
                      <select name="status" id="singer-group-status">
                        <option value="" disabled <%= !singerGroup.status ? 'selected' : '' %>>
                          Chọn trạng thái...
                        </option>
                        <option value="active" <%= singerGroup.status == 'active' ? 'selected' : '' %>>Hoạt động</option>
                        <option value="inactive" <%= singerGroup.status == 'inactive' ? 'selected' : '' %>>Vô hiệu hóa</option>
                      </select>
                      <span class="form-error form-status-error"></span>
                    </div>
                  </div>
                  <div class="col-12">
                    <div class="form-group update-description-group">
                      <label
                        for="singer-group-description"
                        class="form-label update-description-label"
                        >Mô tả</label
                      >
                      <textarea
                        name="description"
                        class="update-description-input tinymce-editor"
                        id="singer-group-description"
                      ><%= singerGroup.description %></textarea>
                      <span class="form-error form-description-error"></span>
                    </div>
                  </div>
                  <div class="col-12">
                    <div
                      class="d-flex justify-content-center form-button-group"
                    >
                      <button
                        type="submit"
                        class="button-primary text-decoration-none"
                      >
                        Cập nhật nhóm <i class="fa-solid fa-pen"></i>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </form>
          </div>
          <div class="card-footer bg-white"></div>
        </div>
      </section>
    </main>

    <%-include('../../partials/footer.view.ejs') %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script
      src="https://kit.fontawesome.com/aaf479b433.js"
      crossorigin="anonymous"
    ></script>
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.5.2/dist/js/tom-select.complete.min.js"></script>
    <script src="/admin/scripts/lib/tomSelectConfig.js"></script>
    <script src="/tinymce/tinymce.min.js"></script>
    <script src="/admin/scripts/lib/tinyMCEConfig.js"></script>

    <script src="/admin/scripts/singerGroup/validateForm.js"></script>
    <script src="/admin/scripts/singerGroup/handleFormSubmit.js"></script>
    <script src="/admin/scripts/index.js"></script>
  </body>
</html>
