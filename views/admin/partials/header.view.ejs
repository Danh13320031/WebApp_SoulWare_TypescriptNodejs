<header class="shadow p-3 header" id="header">
  <div class="d-flex align-items-center justify-content-between header-wrapper">
    <div
      class="d-flex align-items-center justify-content-center gap-2 header-button"
    >
      <a href="">
        <img
          src="/images/logo-removebg-preview.png"
          alt="Soulware Logo"
          height="40"
          class="d-block d-md-none header-logo-img"
        />
      </a>
      <!-- <button
        class="button-icon-main border-0 p-0 d-flex align-items-center justify-content-center header-button-toggle"
      >
        <i class="fa-solid fa-circle-half-stroke"></i>
      </button> -->
      <button
        class="button-icon-main border-0 p-0 d-flex d-md-none align-items-center justify-content-center header-button-menu"
      >
        <i class="fa-solid fa-bars"></i>
      </button>
    </div>
    <div class="d-flex align-items-center gap-2 header-setting">
      <div class="header-setting-darkmode">
        <button
          class="button-icon-main border-0 p-0 d-flex align-items-center justify-content-center header-setting-darkmode-button"
        >
          <i class="fa-solid fa-moon"></i>
        </button>
      </div>
      <div class="position-relative header-setting-notification">
        <button
          class="button-icon-main border-0 p-0 d-flex align-items-center justify-content-center header-setting-notification-button"
        >
          <i class="fa-solid fa-bell"></i>
        </button>
        <div
          class="position-absolute d-none end-0 top-100 p-3 rounded-3 shadow bg-white header-setting-notification-count"
          style="width: 240px"
        >
          <ul class="list-unstyled mb-0 header-setting-notification-count-list">
            <li class="header-setting-notification-count-item">
              <a
                href=""
                class="text-decoration-none d-flex align-items-center gap-2 header-setting-notification-count-link"
              >
                <span class="header-setting-notification-count-link-avatar">
                  <img
                    src="https://i.pravatar.cc/300?img=1"
                    alt="Avatar"
                    width="32"
                    height="32"
                    class="rounded-circle header-setting-notification-count-link-avatar-img"
                  />
                </span>
                <span class="header-setting-notification-count-link-content">
                  Thông báo mới
                </span>
              </a>
            </li>
          </ul>
        </div>
      </div>
      <div class="position-relative header-setting-user">
        <a
          href=""
          class="text-decoration-none d-flex align-items-center gap-2 header-setting-user-link"
        >
          <span
            class="border border-2 rounded-circle p-1 header-setting-user-link-avatar"
          >
            <img
              src="https://i.pravatar.cc/300?img=2"
              alt="Avatar"
              width="32"
              height="32"
              class="rounded-circle header-setting-user-link-avatar-img"
            />
          </span>
          <span class="header-setting-user-link-name">Admin</span>
        </a>

        <div
          class="position-absolute d-none end-0 top-100 p-3 rounded-3 shadow bg-white header-setting-user-menu"
          style="width: 240px"
        >
          <ul class="list-unstyled mb-0 header-setting-user-menu-list">
            <li class="header-setting-user-menu-item">
              <a
                href=""
                class="text-decoration-none d-flex align-items-center gap-2 header-setting-user-menu-link"
              >
                <span class="header-setting-user-menu-link-icon">
                  <i class="fa-solid fa-user"></i>
                </span>
                <span class="header-setting-user-menu-link-content">
                  Tài khoản
                </span>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</header>
